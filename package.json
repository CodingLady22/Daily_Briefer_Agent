    "@langchain/langgraph": "latest",
    "@langchain/openai": "latest",
    "@langchain/tavily": "latest",
    "axios": "latest",
    "cheerio": "latest",
    "dotenv": "latest",
    "mongoose": "latest",
    "resend": "latest",
    "tsx": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest"
  }
}
